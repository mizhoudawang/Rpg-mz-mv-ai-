# 默认：文本文件统一按 LF 存入仓库，检出为 LF，保证跨平台一致
* text=auto eol=lf

# ── Windows 专用入口：字节保真，禁止任何换行 / 编码转换 ──────────────
# 一键安装.bat 走 chcp 65001、_oneclick.ps1 带 UTF-8 BOM、tools\*.bat 是
# cmd 脚本 —— 一旦被换行转换或重编码就可能解析失败或乱码。
*.bat   -text
*.cmd   -text
*.ps1   -text

# 说明文档：仓库内存 LF、检出为 CRLF（用 Windows 记事本打开才正常换行）
*.txt   text eol=crlf

# ── 二进制 ──────────────────────────────────────────────────────
*.zip   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.ttf   binary
*.woff  binary
*.woff2 binary

# ── 语言统计 ────────────────────────────────────────────────────
*.js              linguist-language=JavaScript
RM_AI_NPC.js      linguist-generated=false
*.html            linguist-language=HTML
